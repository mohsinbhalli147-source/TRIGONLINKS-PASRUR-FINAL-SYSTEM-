# Where the Trigon Links API is running during development.
#
# The subscriber app is served by Vite on 5174 and proxies its /api calls here,
# so the app and the API look same-origin to the browser and the httpOnly session
# cookie is sent. It must match PORT in the root .env, otherwise every sign-in
# attempt fails with a proxy error rather than an auth error.
TRIGON_API_ORIGIN=http://localhost:3010
