<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is disabled outright (usesCleartextTraffic="false" in the
  manifest too), so a misconfigured API host fails loudly instead of sending a
  subscriber's CNIC over plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
