# ==========================================================================
#  All secrets are REQUIRED and have no built-in default. The server refuses
#  to start if any of them is missing, so a committed key can never be
#  mistaken for a rotated one.
# ==========================================================================

# Appwrite server API key. Create it in the Appwrite console under
# Overview > Integrations > API Keys. It needs read/write access to databases,
# users and teams. NEVER expose this to the browser.
APPWRITE_API_KEY=""

# Signing key for the httpOnly session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Appwrite identifiers. Not secrets, but they must match your project.
APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID=""
APPWRITE_DATABASE_ID=""

# Optional runtime tuning
PORT=3000
SESSION_TTL_HOURS=8
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# ==========================================================================
#  First-run administrator. Used only by "npm run provision".
#  Leave ADMIN_EMAIL empty to skip bootstrapping an administrator.
#  Generate a strong password with:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
# ==========================================================================
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_NAME="Super Admin"

# ==========================================================================
#  Google Workspace (optional). Restrict the Firebase API key by HTTP referrer
#  and lock the OAuth client to your authorised origins before using these.
# ==========================================================================
